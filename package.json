{
  "name": "cleanproof",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Sicy International Ltd CleanProof \u2014 inspections and reporting (release preparation)",
  "main": "expo-router/entry",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "expo start --dev-client --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "preview:report": "tsc -p tsconfig.tests.json && node scripts/report-preview.mjs",
    "preview:workflows": "npm run preview:report && node scripts/build-workflow-preview.mjs",
    "test:backend": "tsc -p tsconfig.tests.json && npm test --prefix backend",
    "check:all": "npm run check && npm run test:backend",
    "test:full-stack": "tsc -p tsconfig.tests.json && node backend/full-stack.mjs",
    "test:auth-live": "node backend/auth-live.mjs",
    "cleanup:photos": "node backend/cleanup.mjs",
    "backup:files": "node backend/backup-files.mjs",
    "preview:app": "node scripts/serve-app-preview.mjs",
    "export:app": "expo export --platform web --output-dir artifacts/browser-app",
    "preview:app:dev": "expo start --web --localhost --port 8081",
    "seed:demo": "tsc -p tsconfig.tests.json && node backend/seed-demo.mjs",
    "backup:paired": "node backend/paired-snapshot.mjs",
    "test:preview": "node scripts/test-browser-app.mjs",
    "test:device-handoff": "node --test scripts/android-device-handoff.test.mjs",
    "build": "node scripts/build-connected-staging.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:onboarding-live": "tsc -p tsconfig.tests.json && node backend/onboarding-live.mjs",
    "build:staging": "node scripts/build-customer.mjs",
    "test:build-config": "node --test scripts/build-customer.test.mjs",
    "build:demo": "EXPO_PUBLIC_CLEANPROOF_DEMO_TOOLS=1 EXPO_PUBLIC_CLEANPROOF_PREVIEW_LOCAL_ONLY=1 expo export --platform web --output-dir dist",
    "test:staging-smoke": "node backend/staging-smoke.mjs",
    "test:release-config": "node --test release/config.test.cjs",
    "release:status": "node scripts/store-release-check.mjs",
    "test:customer-live": "tsc -p tsconfig.tests.json && node backend/customer-release-live.mjs",
    "test:workflow-live": "tsc -p tsconfig.tests.json && node backend/customer-workflow-live.mjs",
    "admin:eas": "node --env-file=.env.local scripts/admin-eas.mjs",
    "build:website": "node scripts/build-production-web.mjs",
    "test:website": "node --test scripts/production-web-config.test.mjs",
    "release:website": "node scripts/check-website-release.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.10",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/sql.js": "1.4.9",
    "typescript": "6.0.3"
  }
}
