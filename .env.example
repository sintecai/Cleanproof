# Local Supabase only for this phase. The publishable/legacy anon key is public, not a server secret.
# Copy values from `supabase status`; never use service_role or sb_secret_ in EXPO_PUBLIC variables.
EXPO_PUBLIC_CLEANPROOF_BACKEND_URL=http://127.0.0.1:54321
EXPO_PUBLIC_CLEANPROOF_BACKEND_KEY=replace-with-local-anon-or-publishable-key
# Android emulator: URL http://10.0.2.2:54321.
# Delivered synthetic APK: USB phone uses adb reverse tcp:54321 tcp:54321, then 127.0.0.1:54321.
# Loopback without adb reverse points to the phone. Arbitrary LAN HTTP is blocked by native transport policy.

# The optional local integration harness reads CLEANPROOF_LOCAL_URL,
# CLEANPROOF_LOCAL_ANON_KEY and CLEANPROOF_LOCAL_SERVICE_KEY from a separate private
# terminal environment. Never put a service key in this mobile .env file or any EXPO_PUBLIC value.

# Auth/mailbox/maintenance/backup tools also read their private values only from
# CLEANPROOF_LOCAL_JWT_SECRET, CLEANPROOF_LOCAL_MAILBOX_URL,
# CLEANPROOF_CLEANUP_COMPANY and CLEANPROOF_BACKUP_PASSPHRASE in a terminal.
# Do not add private values to this mobile configuration.

# Explicit development-only fixture creation and loopback Android HTTP exception.
# Set 1 only for the synthetic internal preview build; keep disabled for release.
EXPO_PUBLIC_CLEANPROOF_DEMO_TOOLS=0

# Customer builds must leave showcase disabled. Use build-showcase.mjs only for isolated synthetic hosting.
EXPO_PUBLIC_CLEANPROOF_SHOWCASE=0
